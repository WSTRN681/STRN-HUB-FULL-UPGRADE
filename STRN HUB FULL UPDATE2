	Lighting.FogEnd=originalLighting.FogEnd
	Lighting.Ambient=originalLighting.Ambient
	Lighting.OutdoorAmbient=originalLighting.OutdoorAmbient
	Lighting.GlobalShadows=originalLighting.GlobalShadows
	graphicEffect.Brightness=0; graphicEffect.Contrast=0; graphicEffect.Saturation=0; graphicEffect.TintColor=Color3.fromRGB(255,255,255)
	for obj,state in pairs(originalEffectsStates) do if obj and obj.Parent then obj.Enabled=state end end
	for obj,state in pairs(originalParticleStates) do if obj and obj.Parent then obj.Enabled=state end end
	table.clear(originalEffectsStates); table.clear(originalParticleStates)
	if nightVision then nightEffect.Enabled=true; updateNightVision()
	else nightEffect.Enabled=false; nightEffect.Brightness=0; nightEffect.Contrast=0 end
