local isFlying = false
local flySpeed = 50
local linearVelocity, alignOrientation, attachment = nil, nil, nil
local flyConn = nil

local function stopFly()
    isFlying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if linearVelocity then linearVelocity:Destroy() linearVelocity = nil end
    if alignOrientation then alignOrientation:Destroy() alignOrientation = nil end
    if attachment then attachment:Destroy() attachment = nil end
    local hum = getHumanoid()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    stopFly()
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum then return end

    isFlying = true
    hum.PlatformStand = true

    attachment = Instance.new("Attachment")
    attachment.Name = "STRN_FlyAttachment"
    attachment.Parent = root

    linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Attachment0 = attachment
    linearVelocity.MaxForce = math.huge
    linearVelocity.VectorVelocity = Vector3.zero
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.Parent = root

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Attachment0 = attachment
    alignOrientation.MaxTorque = math.huge
    alignOrientation.Responsiveness = 200
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.CFrame = root.CFrame
    alignOrientation.Parent = root

    flyConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not getRoot() or not getHumanoid() then
            stopFly()
            return
        end
        hum.PlatformStand = true
        local moveDir = hum.MoveDirection
        local cameraCF = Camera.CFrame
        local flyVector = Vector3.zero

        if moveDir.Magnitude > 0 then
            local cameraForward = cameraCF.LookVector
            local cameraRight = cameraCF.RightVector
            local forwardDot = moveDir:Dot(cameraCF.LookVector * Vector3.new(1, 0, 1).Unit)
            local rightDot = moveDir:Dot(cameraCF.RightVector * Vector3.new(1, 0, 1).Unit)
            flyVector = (cameraForward * forwardDot + cameraRight * rightDot).Unit * flySpeed
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            flyVector = flyVector + Vector3.new(0, flySpeed, 0)
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            flyVector = flyVector - Vector3.new(0, flySpeed, 0)
        end

        linearVelocity.VectorVelocity = flyVector
        alignOrientation.CFrame = cameraCF
    end)
end

