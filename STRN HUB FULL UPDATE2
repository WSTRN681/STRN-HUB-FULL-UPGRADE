local function stopSpectating()
	spectatingPlayer=nil; spectateTargetName=nil
	if spectatorConnection then spectatorConnection:Disconnect() spectatorConnection=nil end
	if selectedSpectButton and selectedSpectButton.Parent then selectedSpectButton.BackgroundColor3=BUTTON_HOVER end
	selectedSpectButton=nil
	Camera.CameraType=Enum.CameraType.Custom
	local humanoid=getHumanoid()
	if humanoid then Camera.CameraSubject=humanoid end
	stopSpectateButton.Visible=false
	refreshPlayerList()
end
local function spectatePlayer(target,spectButton)
	if not target or target==Player then return end
	local character=target.Character
	local humanoid=getHumanoid(character)
	if not character or not humanoid then return end
	if selectedSpectButton and selectedSpectButton~=spectButton and selectedSpectButton.Parent then selectedSpectButton.BackgroundColor3=BUTTON_HOVER end
	spectatingPlayer=target; spectateTargetName=target.Name; selectedSpectButton=spectButton
	spectButton.BackgroundColor3=SPECT_SELECTED
	Camera.CameraType=Enum.CameraType.Custom; Camera.CameraSubject=humanoid
	stopSpectateButton.Visible=true
	if spectatorConnection then spectatorConnection:Disconnect() end
	spectatorConnection=RunService.RenderStepped:Connect(function()
		if not spectatingPlayer then return end
		local currentCharacter=spectatingPlayer.Character
		local currentHumanoid=getHumanoid(currentCharacter)
		if currentHumanoid then
			if Camera.CameraSubject~=currentHumanoid then Camera.CameraSubject=currentHumanoid end
		else stopSpectating() end
	end)
	refreshPlayerList()
end
stopSpectateButton.MouseButton1Click:Connect(stopSpectating)

