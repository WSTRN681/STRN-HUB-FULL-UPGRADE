   rideTargetName = nil
   if rideConnection then
      rideConnection:Disconnect()
      rideConnection = nil
   end
   if selectedRideButton and selectedRideButton.Parent then
      selectedRideButton.BackgroundColor3 = BUTTON_HOVER
      selectedRideButton.Text = "RIDE"
   end
   selectedRideButton = nil
   stopRideButton.Visible = false
   refreshPlayerList()
end

local function ridePlayer(target, rideButton)
   if not target or target == Player then return end
   local targetCharacter = target.Character
   local targetRoot = getRoot(targetCharacter)
   if not targetRoot then return end

   if ridingPlayer == target then
      stopRide()
      return
   end

   if selectedRideButton and selectedRideButton ~= rideButton and selectedRideButton.Parent then
      selectedRideButton.BackgroundColor3 = BUTTON_HOVER
      selectedRideButton.Text = "RIDE"
   end

   ridingPlayer = target
   rideTargetName = target.Name
   selectedRideButton = rideButton
   rideButton.BackgroundColor3 = RIDE_SELECTED
   rideButton.Text = "RIDING"
   stopRideButton.Visible = true

   if rideConnection then
      rideConnection:Disconnect()
      rideConnection = nil
   end

   rideConnection = RunService.RenderStepped:Connect(function()
      if not ridingPlayer then return end
      local targetCharacter = ridingPlayer.Character
      local targetRoot = getRoot(targetCharacter)
      local myCharacter = Player.Character
      local myRoot = getRoot(myCharacter)
      if not targetRoot or not myRoot then return end
      local newPosition = targetRoot.Position + RIDE_OFFSET
      myRoot.CFrame = CFrame.new(newPosition)
      myRoot.AssemblyLinearVelocity = Vector3.zero
      myRoot.AssemblyAngularVelocity = Vector3.zero
   end)

   refreshPlayerList()
end
stopRideButton.MouseButton1Click:Connect(stopRide)

local function teleportToPlayer(target)
	if not target or target==Player then return false end
	local targetRoot=getRoot(target.Character)
	local root=getRoot(Player.Character)
	if not targetRoot or not root then return false end
	root.CFrame=targetRoot.CFrame*CFrame.new(0,0,3)
	return true
end

