            local userLbl = Instance.new("TextLabel")
            userLbl.Size = UDim2.new(1, -165, 0, 16)
            userLbl.Position = UDim2.fromOffset(50, 28)
            userLbl.BackgroundTransparency = 1
            userLbl.Text = "@" .. targetP.Name
            userLbl.TextColor3 = TEXT_SUB
            userLbl.TextSize = 9
            userLbl.Font = Enum.Font.Gotham
            userLbl.TextXAlignment = Enum.TextXAlignment.Left
            userLbl.TextTruncate = Enum.TextTruncate.AtEnd
            userLbl.ZIndex = 117
            userLbl.Parent = pCard

            -- SPECTATE
            local spectBtn = Instance.new("TextButton")
            spectBtn.Size = UDim2.fromOffset(36, 26)
            spectBtn.Position = UDim2.new(1, -122, 0.5, -13)
            spectBtn.BackgroundColor3 = (spectatingPlayer == targetP) and ACCENT_RED or SPECT_COLOR
            spectBtn.Text = (spectatingPlayer == targetP) and "STOP" or "SPECT"
            spectBtn.TextColor3 = TEXT_MAIN
            spectBtn.TextSize = 8
            spectBtn.Font = Enum.Font.GothamBold
            spectBtn.AutoButtonColor = false
            spectBtn.ZIndex = 118
            spectBtn.Parent = pCard

            local sCorner = Instance.new("UICorner")
            sCorner.CornerRadius = UDim.new(0, 6)
            sCorner.Parent = spectBtn

            spectBtn.MouseButton1Click:Connect(function()
                if spectatingPlayer == targetP then
                    stopSpectating()
                    showToast("Spectate", "Kamera kembali normal", ACCENT_BLUE)
                else
                    stopSpectating()
                    spectatingPlayer = targetP
                    spectatorConn = RunService.RenderStepped:Connect(function()
                        if spectatingPlayer then
                            local tHum = getHumanoid(spectatingPlayer)
                            if tHum then 
                                Camera.CameraSubject = tHum 
                            end
                        else stopSpectating() end
                    end)
                    showToast("Spectate Target", "Mengamati " .. targetP.DisplayName, ACCENT_GREEN)
                end
                refreshPlayerList()
            end)

            -- RIDE (DENGAN TAHAN RESPAWN PERSISTENT)
            local rideBtn = Instance.new("TextButton")
            rideBtn.Size = UDim2.fromOffset(36, 26)
            rideBtn.Position = UDim2.new(1, -82, 0.5, -13)
            rideBtn.BackgroundColor3 = (ridingPlayer == targetP) and ACCENT_RED or RIDE_COLOR
            rideBtn.Text = (ridingPlayer == targetP) and "STOP" or "RIDE"
            rideBtn.TextColor3 = TEXT_MAIN
            rideBtn.TextSize = 8
            rideBtn.Font = Enum.Font.GothamBold
            rideBtn.AutoButtonColor = false
            rideBtn.ZIndex = 118
            rideBtn.Parent = pCard

            local rCorner = Instance.new("UICorner")
            rCorner.CornerRadius = UDim.new(0, 6)
            rCorner.Parent = rideBtn

            rideBtn.MouseButton1Click:Connect(function()
                if ridingPlayer == targetP then
                    stopRide()
                    showToast("Ride Player", "Berhenti menunggangi", ACCENT_BLUE)
                else
                    stopRide()
                    ridingPlayer = targetP
                    rideConn = RunService.Heartbeat:Connect(function()
                        if ridingPlayer then
                            local tRoot = getRoot(ridingPlayer)
                            local myRoot = getRoot()
                            if tRoot and myRoot then
                                myRoot.CFrame = CFrame.new(tRoot.Position + RIDE_OFFSET)
                                myRoot.AssemblyLinearVelocity = Vector3.zero
                            end
                        else stopRide() end
                    end)
                    showToast("Ride Player", "Menunggangi " .. targetP.DisplayName, ACCENT_GREEN)
                end
                refreshPlayerList()
            end)

            -- TP
            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.fromOffset(36, 26)
            tpBtn.Position = UDim2.new(1, -42, 0.5, -13)
            tpBtn.BackgroundColor3 = ACCENT_BLUE
            tpBtn.Text = "TP"
            tpBtn.TextColor3 = TEXT_MAIN
            tpBtn.TextSize = 8
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.AutoButtonColor = false
            tpBtn.ZIndex = 118
            tpBtn.Parent = pCard

            local tCorner = Instance.new("UICorner")
            tCorner.CornerRadius = UDim.new(0, 6)
            tCorner.Parent = tpBtn

            tpBtn.MouseButton1Click:Connect(function()
                local root = getRoot()
                local tRoot = getRoot(targetP)
                if root and tRoot then
                    root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
                    showToast("Teleport Player", "Teleport ke " .. targetP.DisplayName, ACCENT_BLUE)
                end
            end)
        end
    end
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, idx * 64)
end

refreshPlayerList()
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(function(p)
    if spectatingPlayer == p then stopSpectating() end
    if ridingPlayer == p then stopRide() end
    refreshPlayerList()
end)

