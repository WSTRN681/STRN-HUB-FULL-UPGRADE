local CONFIG_KEY="STRN_HUB_CONFIG"
local function saveConfig()
	local config={wallHack=wallHack,infiniteJump=infiniteJump,nightVision=nightVision,fullbright=fullbright,fogControl=fogControl,fpsBoost=fpsBoost,antiAFK=antiAFK,selectedSpeed=selectedSpeed,brightness=brightnessValue,colorBoost=colorBoostValue,contrast=contrastValue}
	local json=HttpService:JSONEncode(config)
	pcall(function() HttpService:SetAsync(CONFIG_KEY,json) end)
end
local function loadConfig()
	local success,json=pcall(function() return HttpService:GetAsync(CONFIG_KEY) end)
	if success and json then
		local config=HttpService:JSONDecode(json)
		wallHack=config.wallHack or false
		infiniteJump=config.infiniteJump or false
		nightVision=config.nightVision or false
		fullbright=config.fullbright or false
		fogControl=config.fogControl or false
		fpsBoost=config.fpsBoost or false
		antiAFK=config.antiAFK or false
		selectedSpeed=config.selectedSpeed or 1
		brightnessValue=config.brightness or 0
		colorBoostValue=config.colorBoost or 0
		contrastValue=config.contrast or 0
		return true
	end
	return false
end

