-- ANIMASI SMOOTH BUKA & TUTUP MENU
local isAnimating = false

local function openMenuSmooth()
    if isAnimating then return end
    isAnimating = true
    openButton.Visible = false
    frame.Size = hiddenSize
    frame.BackgroundTransparency = 1
    frameStroke.Transparency = 1
    frame.Visible = true

    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local tweenSize = TweenService:Create(frame, tweenInfo, {Size = normalSize, BackgroundTransparency = 0})
    local tweenStroke = TweenService:Create(frameStroke, tweenInfo, {Transparency = 0})

    tweenSize:Play()
    tweenStroke:Play()
    tweenSize.Completed:Connect(function()
        isAnimating = false
    end)
end

local function closeMenuSmooth()
    if isAnimating then return end
    isAnimating = true

    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    local tweenSize = TweenService:Create(frame, tweenInfo, {Size = hiddenSize, BackgroundTransparency = 1})
    local tweenStroke = TweenService:Create(frameStroke, tweenInfo, {Transparency = 1})

    tweenSize:Play()
    tweenStroke:Play()
    tweenSize.Completed:Connect(function()
        frame.Visible = false
        openButton.Visible = true
        isAnimating = false
    end)
end

closeButton.MouseButton1Click:Connect(closeMenuSmooth)

local isDraggingMenu=false
local dragStartPos=nil
local dragStartMouse=nil
