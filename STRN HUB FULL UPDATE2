local originalEffectsStates={}
local function setFPSBoost(state)
	fpsBoost=state
	if state then
		for _,obj in ipairs(Lighting:GetDescendants()) do
			if obj:IsA("PostEffect") then
				if originalEffectsStates[obj]==nil then originalEffectsStates[obj]=obj.Enabled end
				if obj~=nightEffect and obj~=graphicEffect then obj.Enabled=false end
			end
		end
		for _,obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
				if originalParticleStates[obj]==nil then originalParticleStates[obj]=obj.Enabled end
				obj.Enabled=false
			end
		end
		Lighting.GlobalShadows=false
	else
		Lighting.GlobalShadows=originalLighting.GlobalShadows
		for obj,state in pairs(originalEffectsStates) do if obj and obj.Parent then obj.Enabled=state end end
		for obj,state in pairs(originalParticleStates) do if obj and obj.Parent then obj.Enabled=state end end
		table.clear(originalEffectsStates)
		table.clear(originalParticleStates)
	end
end
fpsBoostButton.MouseButton1Click:Connect(function()
	setFPSBoost(not fpsBoost)
	fpsBoostButton.Text=fpsBoost and "⚡ FPS Boost       ON" or "⚡ FPS Boost       OFF"
	fpsBoostButton.BackgroundColor3=fpsBoost and ON_COLOR or BUTTON
	saveConfig()
end)

