local function getCharacter(targetP) 
    targetP = targetP or Player 
    return targetP.Character 
end

local function getHumanoid(cOrPlayer) 
    local char = (typeof(cOrPlayer) == "Instance" and cOrPlayer:IsA("Player")) and cOrPlayer.Character or cOrPlayer
    char = char or getCharacter() 
    return char and char:FindFirstChildOfClass("Humanoid") 
end

local function getRoot(cOrPlayer) 
    local char = (typeof(cOrPlayer) == "Instance" and cOrPlayer:IsA("Player")) and cOrPlayer.Character or cOrPlayer
    char = char or getCharacter() 
    return char and char:FindFirstChild("HumanoidRootPart") 
end

