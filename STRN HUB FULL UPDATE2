		emptyLabel.TextSize=13
		emptyLabel.Font=Enum.Font.Gotham
		emptyLabel.ZIndex=116
		emptyLabel.Parent=playerList
	end
	task.wait()
	local contentHeight=math.max(playerLayout.AbsoluteContentSize.Y,50)
	playerList.Size=UDim2.new(1,-10,0,contentHeight)
	updatePlayerPageCanvas()
end

