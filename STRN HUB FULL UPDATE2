local function createSlider(parent,labelText,y,minValue,maxValue,initialValue,callback)
    local label=Instance.new("TextLabel")
    label.Size=UDim2.new(1,-10,0,22)
    label.Position=UDim2.fromOffset(5,y)
    label.BackgroundTransparency=1
    label.TextColor3=TEXT
    label.TextSize=14
    label.Font=Enum.Font.GothamMedium
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.ZIndex=115
    label.Parent=parent
    local sliderFrame=Instance.new("Frame")
    sliderFrame.Size=UDim2.new(1,-10,0,35)
    sliderFrame.Position=UDim2.fromOffset(5,y+24)
    sliderFrame.BackgroundColor3=BUTTON
    sliderFrame.BorderSizePixel=0
    sliderFrame.ZIndex=115
    sliderFrame.Active=true
    sliderFrame.Parent=parent
    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,10)
    corner.Parent=sliderFrame
    local sliderBar=Instance.new("Frame")
    sliderBar.Size=UDim2.new(1,-30,0,5)
    sliderBar.Position=UDim2.new(0,15,0.5,-2)
    sliderBar.BackgroundColor3=Color3.fromRGB(90,90,100)
    sliderBar.BorderSizePixel=0
    sliderBar.ZIndex=116
    sliderBar.Parent=sliderFrame
    local barCorner=Instance.new("UICorner")
    barCorner.CornerRadius=UDim.new(1,0)
    barCorner.Parent=sliderBar
    local fill=Instance.new("Frame")
    fill.Size=UDim2.new(0,0,1,0)
    fill.Position=UDim2.fromScale(0,0)
    fill.BackgroundColor3=ON_COLOR
    fill.BorderSizePixel=0
    fill.ZIndex=117
    fill.Parent=sliderBar
    local fillCorner=Instance.new("UICorner")
    fillCorner.CornerRadius=UDim.new(1,0)
    fillCorner.Parent=fill
    local sliderKnob=Instance.new("TextButton")
    sliderKnob.Size=UDim2.fromOffset(18,18)
    sliderKnob.AnchorPoint=Vector2.new(0.5,0.5)
    sliderKnob.BackgroundColor3=Color3.fromRGB(255,255,255)
    sliderKnob.BorderSizePixel=0
    sliderKnob.Text=""
    sliderKnob.AutoButtonColor=false
    sliderKnob.ZIndex=119
    sliderKnob.Active=true
    sliderKnob.Parent=sliderFrame
    local knobCorner=Instance.new("UICorner")
    knobCorner.CornerRadius=UDim.new(1,0)
    knobCorner.Parent=sliderKnob
    local value=initialValue
    local draggingSlider=false
    local function updateLabel()
        label.Text=labelText.." • "..string.format("%.1f",value)
    end
    local function updateVisual()
        local width=sliderBar.AbsoluteSize.X
        if width<=0 then return end
        local range=maxValue-minValue
        if range<=0 then return end
        local percent=math.clamp((value-minValue)/range,0,1)
        local x=width*percent
        sliderKnob.Position=UDim2.new(0,15+x,0.5,0)
        fill.Size=UDim2.new(0,x,1,0)
    end
    local function setValueFromX(x)
        local width=sliderBar.AbsoluteSize.X
        if width<=0 then return end
        x=math.clamp(x,0,width)
        local percent=x/width
        value=minValue+(maxValue-minValue)*percent
        value=math.clamp(value,minValue,maxValue)
        updateVisual()
        updateLabel()
        callback(value)
    end
    local function getInputX(input)
        return input.Position.X-sliderBar.AbsolutePosition.X
    end
    local function beginDrag(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            draggingSlider=true
            setValueFromX(getInputX(input))
        end
    end
    sliderFrame.InputBegan:Connect(beginDrag)
    sliderKnob.InputBegan:Connect(beginDrag)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            setValueFromX(getInputX(input))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            draggingSlider=false
        end
    end)
    updateLabel()
    task.wait(0.1)
    updateVisual()
    return {
        GetValue=function() return value end,
        SetValue=function(newValue)
            value=math.clamp(newValue,minValue,maxValue)
            updateVisual()
            updateLabel()
            callback(value)
        end
    }
end

