local function stopOrbit()
    isOrbiting = false
    if orbitConn then orbitConn:Disconnect() orbitConn = nil end
    orbitToggleBtn.Text = "🌀 Start Orbit"
    orbitToggleBtn.BackgroundColor3 = ACCENT_RED
    
    Camera.CameraType = Enum.CameraType.Custom
    local hum = getHumanoid()
    if hum then 
        hum.PlatformStand = false
        Camera.CameraSubject = hum 
    end
end

orbitToggleBtn.MouseButton1Click:Connect(function()
    if isOrbiting then
        stopOrbit()
        showToast("Orbit Troll", "Orbit & Spectate Dihentikan", ACCENT_BLUE)
    else
        if not selectedOrbitTarget then
            showToast("Orbit Troll", "Pilih target player dulu!", ACCENT_RED)
            return
        end
        isOrbiting = true
        orbitToggleBtn.Text = "🛑 Stop Orbit"
        orbitToggleBtn.BackgroundColor3 = ACCENT_BLUE
        showToast("Orbit Troll", "Orbiting & Spectating " .. selectedOrbitTarget.DisplayName, ACCENT_GREEN)

        orbitAngle = 0
        orbitConn = RunService.Heartbeat:Connect(function(dt)
            if not isOrbiting or not selectedOrbitTarget then
                stopOrbit()
                return
            end

            -- OTOMATIS AKTIFKAN PLATFORMSTAND KAMU JIKA HUMANOID KAMU ADA (RESPAWNED)
            local myHum = getHumanoid()
            if myHum then 
                myHum.PlatformStand = true 
            end

            -- AUTO SPECTATE PERSISTENT (JIKA TARGET RESPAWN / TERSEDIA)
            local targetHum = getHumanoid(selectedOrbitTarget)
            if targetHum and Camera.CameraSubject ~= targetHum then
                Camera.CameraSubject = targetHum
            end

            -- KALKULASI ORBIT (AKAN MENUNGGU DAN OTOMATIS MENEMPEL JIKA KARAKTER KAMU / TARGET MUNCUL)
            local myRoot = getRoot()
            local tRoot = getRoot(selectedOrbitTarget)

            if myRoot and tRoot then
                orbitAngle = orbitAngle + (dt * orbitSpeed * 2.5)
                local radius = 8
                local x = tRoot.Position.X + math.cos(orbitAngle) * radius
                local z = tRoot.Position.Z + math.sin(orbitAngle) * radius
                local y = tRoot.Position.Y + 2
                myRoot.CFrame = CFrame.new(Vector3.new(x, y, z), tRoot.Position)
                myRoot.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end
end)

