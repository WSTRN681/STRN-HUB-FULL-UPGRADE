local function refreshPlayerList()
	selectedSpectButton=nil; selectedRideButton=nil
	for _,child in ipairs(playerList:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
	local playerCount=0
	for _,target in ipairs(Players:GetPlayers()) do
		if target~=Player then
			local row=createPlayerRow(target)
			playerCount+=1
			if rideTargetName and target.Name==rideTargetName then
				local rideBtn=row:FindFirstChild("RideButton")
				if rideBtn then rideBtn.BackgroundColor3=RIDE_SELECTED; rideBtn.Text="RIDING"; selectedRideButton=rideBtn; ridingPlayer=target; stopRideButton.Visible=true end
			end
			if spectateTargetName and target.Name==spectateTargetName then
				local spectBtn=row:FindFirstChild("SpectButton")
				if spectBtn then spectBtn.BackgroundColor3=SPECT_SELECTED; selectedSpectButton=spectBtn; spectatingPlayer=target; stopSpectateButton.Visible=true
				local humanoid=getHumanoid(target.Character)
				if humanoid then Camera.CameraSubject=humanoid end end
			end
		end
	end
	if playerCount==0 then
		local emptyLabel=Instance.new("TextLabel")
		emptyLabel.Size=UDim2.new(1,0,0,40)
		emptyLabel.BackgroundTransparency=1
		emptyLabel.Text="Tidak ada player lain di server."
