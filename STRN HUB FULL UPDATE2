local MIN_BRIGHTNESS=0; local MAX_BRIGHTNESS=0.75
local MIN_CONTRAST=0; local MAX_CONTRAST=0.10
local function updateNightVision()
	if not nightVision then return end
	local brightness=math.clamp(Lighting.Brightness,0,5)
	local exposure=Lighting.ExposureCompensation
	local darkness=1-math.clamp((brightness+exposure+1)/6,0,1)
	darkness=math.clamp(darkness,0,1)
	nightEffect.Brightness=MIN_BRIGHTNESS+((MAX_BRIGHTNESS-MIN_BRIGHTNESS)*darkness)
	nightEffect.Contrast=MIN_CONTRAST+((MAX_CONTRAST-MIN_CONTRAST)*darkness)
end
local function setNightVision(state)
	nightVision=state
	if nightVisionConnection then nightVisionConnection:Disconnect() nightVisionConnection=nil end
	if state then
		nightEffect.Enabled=true
		updateNightVision()
		nightVisionConnection=RunService.RenderStepped:Connect(updateNightVision)
	else
		nightEffect.Enabled=false
		nightEffect.Brightness=0
		nightEffect.Contrast=0
	end
end
