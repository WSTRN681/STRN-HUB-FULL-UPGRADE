local function setSpeed(index)
	index=math.clamp(math.floor(index+0.5),1,#speedLevels)
	selectedSpeed=index
	local data=speedLevels[index]
	local humanoid=getHumanoid()
	if humanoid then humanoid.WalkSpeed=data.speed end
	local barWidth=bar.AbsoluteSize.X
	if barWidth>0 then
		local x=barWidth*(data.percent/100)
		knob.Position=UDim2.new(0,15+x,0.5,0)
	end
	speedLabel.Text=data.percent==0 and "Speed • Normal • 0%" or ("Speed • "..data.percent.."%")
	saveConfig()
end
local function selectSpeed(input)
	local width=bar.AbsoluteSize.X
	if width<=0 then return end
	local x=input.Position.X-bar.AbsolutePosition.X
	x=math.clamp(x,0,width)
	local percent=(x/width)*100
	local closest=1
	local distance=math.huge
	for i,data in ipairs(speedLevels) do
		local d=math.abs(percent-data.percent)
		if d<distance then distance=d; closest=i end
	end
	setSpeed(closest)
end
