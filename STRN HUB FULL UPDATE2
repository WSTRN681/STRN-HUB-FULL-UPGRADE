local function startOrbit()
    if not orbitTarget then
        orbitStatus.Text="Status: No target selected!"
        orbitStatus.TextColor3=Color3.fromRGB(255,100,100)
        return
    end
    if orbitActive then stopOrbit() end

    local myHumanoid=getHumanoid()
    local myRoot=getRoot()
    if myHumanoid then
        myHumanoid.PlatformStand=false
        myHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    if myRoot then
        myRoot:SetNetworkOwnershipAuto()
    end

    local targetChar=orbitTarget.Character
    local humanoid=getHumanoid(targetChar)
    if humanoid then
        Camera.CameraType=Enum.CameraType.Custom
        Camera.CameraSubject=humanoid
    end

    orbitActive=true
    orbitAngle=0
    orbitRadius=math.random(5,15)
    orbitRandomY=math.random(3,8)
    orbitStatus.Text="Status: Orbiting "..orbitTarget.DisplayName.." (Radius: "..orbitRadius..")"
    orbitStatus.TextColor3=ON_COLOR
    orbitStartButton.BackgroundColor3=ON_COLOR
    if orbitConnection then orbitConnection:Disconnect() end

    orbitConnection=RunService.Heartbeat:Connect(function()
        if not orbitActive or not orbitTarget then
            stopOrbit()
            return
        end

        local targetChar=orbitTarget.Character
        local targetRoot=getRoot(targetChar)
        local myChar=Player.Character
        local myRoot=getRoot(myChar)

        if not targetRoot or not myRoot then return end

        orbitAngle=orbitAngle+orbitSpeed*0.016
        local x=targetRoot.Position.X+orbitRadius*math.cos(orbitAngle)
        local z=targetRoot.Position.Z+orbitRadius*math.sin(orbitAngle)
        local y=targetRoot.Position.Y+3+math.sin(orbitAngle*1.5)*orbitRandomY

        myRoot.CFrame=CFrame.new(Vector3.new(x,y,z))*CFrame.Angles(0,0,math.sin(orbitAngle*2)*0.3)
        myRoot.AssemblyLinearVelocity=Vector3.zero
        myRoot.AssemblyAngularVelocity=Vector3.zero

        local myHumanoid2=getHumanoid()
        if myHumanoid2 then
            myHumanoid2.PlatformStand=false
        end

        local currentTargetChar=orbitTarget.Character
        local currentHumanoid=getHumanoid(currentTargetChar)
        if currentHumanoid and Camera.CameraSubject~=currentHumanoid then
            Camera.CameraSubject=currentHumanoid
        end
    end)
end

local function stopOrbit()
    orbitActive=false
    if orbitConnection then orbitConnection:Disconnect() orbitConnection=nil end
    orbitStatus.Text="Status: Idle"
    orbitStatus.TextColor3=SUBTEXT
    orbitStartButton.BackgroundColor3=TROLL_COLOR

    local myHumanoid=getHumanoid()
    if myHumanoid then
        myHumanoid.PlatformStand=false
        Camera.CameraType=Enum.CameraType.Custom
        Camera.CameraSubject=myHumanoid
    end

    local myRoot=getRoot()
    if myRoot then
        myRoot:SetNetworkOwnershipAuto()
    end
end

