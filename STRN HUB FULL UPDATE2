	fogButton.Text="🌫️ Fog Control     OFF"; fogButton.BackgroundColor3=BUTTON
	fpsBoostButton.Text="⚡ FPS Boost       OFF"; fpsBoostButton.BackgroundColor3=BUTTON
	brightnessSlider.SetValue(0); colorSlider.SetValue(0); contrastSlider.SetValue(0)
	saveConfig()
end
