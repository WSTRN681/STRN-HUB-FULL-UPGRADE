            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 8)
            pCorner.Parent = pCard

            local ava = Instance.new("ImageLabel")
            ava.Size = UDim2.fromOffset(36, 36)
            ava.Position = UDim2.fromOffset(8, 11)
            ava.BackgroundColor3 = BUTTON_BG
            ava.BorderSizePixel = 0
            ava.Image = "rbxassetid://6031082533"
            ava.ZIndex = 117
            ava.Parent = pCard

            local avaCorner = Instance.new("UICorner")
            avaCorner.CornerRadius = UDim.new(1, 0)
            avaCorner.Parent = ava

            task.spawn(function()
                local content, isReady = Players:GetUserThumbnailAsync(targetP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
